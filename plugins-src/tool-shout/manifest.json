{
  "id": "tool-shout",
  "version": "1.1.0",
  "abi_version": 1,
  "kind": "tool",
  "display_name": {
    "en-US": "Shout",
    "zh-CN": "大小写转换"
  },
  "description": {
    "en-US": "Shouts text back in uppercase (repeat mode from 1.1.0)",
    "zh-CN": "把文本转换成大写输出（repeat 模式自 1.1.0 起提供）"
  },
  "icon": "assets/icon.svg",
  "author": {
    "name": "Locowrk Team"
  },
  "origin": "official",
  "license": "MIT",
  "tools": [
    {
      "description": "shouts text back in uppercase (optionally repeated)",
      "exposure": "on_demand",
      "name": "shout",
      "schema": {
        "properties": {
          "mode": {
            "enum": [
              "plain",
              "repeat"
            ],
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "text"
        ],
        "type": "object"
      },
      "side_effect": {
        "kind": "pure"
      }
    }
  ]
}
