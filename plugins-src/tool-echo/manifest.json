{
  "id": "tool-echo",
  "version": "0.1.0",
  "abi_version": 1,
  "kind": "tool",
  "display_name": {
    "en-US": "Echo",
    "zh-CN": "回显"
  },
  "description": {
    "en-US": "Echoes text back, optionally transformed",
    "zh-CN": "把文本原样或变换后回显"
  },
  "icon": "assets/icon.svg",
  "author": {
    "name": "Locowrk Team"
  },
  "origin": "official",
  "license": "MIT",
  "tools": [
    {
      "description": "echoes text back, optionally transformed (modes: plain/upper/reverse/panic)",
      "exposure": "on_demand",
      "name": "echo",
      "schema": {
        "properties": {
          "mode": {
            "enum": [
              "plain",
              "upper",
              "reverse",
              "panic"
            ],
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "text"
        ],
        "type": "object"
      },
      "side_effect": {
        "kind": "pure"
      }
    }
  ]
}
