{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Locowrk",
  "version": "0.1.0",
  "identifier": "com.locowrk.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "splash",
        "url": "splash.html",
        "title": "Locowrk",
        "width": 340,
        "height": 160,
        "resizable": false,
        "decorations": false,
        "center": true
      },
      {
        "title": "Locowrk",
        "label": "main",
        "width": 1280,
        "height": 820,
        "minWidth": 400,
        "minHeight": 640,
        "decorations": false,
        "visible": false,
        "backgroundColor": "#ffffff"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
